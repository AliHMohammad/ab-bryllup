---
import { Image } from 'astro:assets';
import heroImage from '../assets/vielse-close.jpg';
import { couple, weddingDate, weddingDay, venue } from '../content/wedding';
import { compose, t } from '../i18n';
import Countdown from './Countdown.astro';

const tagline = {
  da: 'Vi skal giftes - og vi vil gerne have jer med.',
  en: 'We are getting married - and we would love for you to be there.',
};
const details = compose(
  (lang) =>
    `${venue.name} · ${venue.city} · ${lang === 'da' ? 'kl.' : 'at'} ${weddingDate.time}`,
);
const cta = { da: 'Se programmet', en: 'See the programme' };
---

<section id="top" class="relative flex min-h-svh flex-col justify-center">
  <div
    class="absolute inset-0 -z-10 overflow-hidden bg-sand"
    aria-hidden="true"
  >
    <Image
      src={heroImage}
      alt=""
      widths={[640, 1080, 1600, 2400, 3024]}
      quality={90}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full scale-[1.02] object-cover grayscale blur-[1.5px]"
    />
    <!-- Lys slør over billedet, så teksten stadig kan læses -->
    <div class="absolute inset-0 bg-[#faf7f2]/70"></div>
  </div>

  <div class="shell py-28 text-center">
    <p class="eyebrow" {...t(weddingDay)}>
      {weddingDay.da}
    </p>

    <h1 class="mt-6 text-hero leading-[0.95]">
      <span class="block">{couple.one}</span>
      <span class="my-1 block text-[0.42em] text-accent italic">&amp;</span>
      <span class="block">{couple.two}</span>
    </h1>

    <hr class="rule rule-center" />

    <p class="mt-6 text-lead text-ink-soft" {...t(tagline)}>
      {tagline.da}
    </p>

    <p
      class="mt-2 text-sm tracking-[0.18em] uppercase text-ink-faint"
      {...t(details)}
    >
      {details.da}
    </p>

    <div class="mt-12">
      <Countdown />
    </div>

    <a href="#program" class="btn btn-primary mt-12" {...t(cta)}>
      {cta.da}
    </a>
  </div>
</section>

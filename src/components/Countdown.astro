---
import { weddingDate } from '../content/wedding';
import { t } from '../i18n';

/**
 * Starttallene regnes ud ved build, så der ikke er et tomt hul før JS kører.
 * Scriptet nedenfor opdaterer dem hvert sekund i browseren.
 */
const target = new Date(weddingDate.iso).getTime();
const diff = Math.max(0, target - Date.now());
const second = 1000;
const minute = 60 * second;
const hour = 60 * minute;
const day = 24 * hour;

const initial = {
  days: Math.floor(diff / day),
  hours: Math.floor((diff % day) / hour),
  minutes: Math.floor((diff % hour) / minute),
  seconds: Math.floor((diff % minute) / second),
};

const units = [
  {
    key: 'days',
    singular: { da: 'dag', en: 'day' },
    plural: { da: 'dage', en: 'days' },
    value: initial.days,
  },
  {
    key: 'hours',
    singular: { da: 'time', en: 'hour' },
    plural: { da: 'timer', en: 'hours' },
    value: initial.hours,
  },
  {
    key: 'minutes',
    singular: { da: 'minut', en: 'minute' },
    plural: { da: 'minutter', en: 'minutes' },
    value: initial.minutes,
  },
  {
    key: 'seconds',
    singular: { da: 'sekund', en: 'second' },
    plural: { da: 'sekunder', en: 'seconds' },
    value: initial.seconds,
  },
];

const todayText = { da: 'I dag er dagen!', en: 'Today is the day!' };
---

<div data-countdown data-target={weddingDate.iso}>
  <p class="sr-only" data-countdown-sr aria-live="polite">
    Der er {initial.days} dage til brylluppet.
  </p>

  <ol
    class="mx-auto grid max-w-md grid-cols-4 gap-2 sm:gap-4"
    data-countdown-list
  >
    {units.map((unit) => (
      <li
        class="rounded-xl border border-sand-deep/50 bg-surface/60 px-1 py-4 backdrop-blur-sm sm:px-3"
        data-unit={unit.key}
        data-singular={unit.singular.da}
        data-plural={unit.plural.da}
        data-singular-en={unit.singular.en}
        data-plural-en={unit.plural.en}
      >
        <span
          class="font-display block text-3xl tabular-nums sm:text-4xl"
          data-value
        >
          {unit.value}
        </span>
        <span
          class="mt-1 block text-[0.625rem] tracking-[0.16em] uppercase text-ink-faint sm:text-xs"
          data-label
        >
          {unit.value === 1 ? unit.singular.da : unit.plural.da}
        </span>
      </li>
    ))}
  </ol>

  <p class="mt-6 hidden text-lead text-accent" data-today {...t(todayText)}>
    {todayText.da}
  </p>
</div>

<script>
  import { currentLang, LANG_EVENT } from '../i18n';

  const SR_TEXT = {
    da: {
      today: 'I dag er dagen!',
      days: (n: number) =>
        n === 1
          ? 'Der er 1 dag til brylluppet.'
          : `Der er ${n} dage til brylluppet.`,
    },
    en: {
      today: 'Today is the day!',
      days: (n: number) =>
        n === 1
          ? 'There is 1 day until the wedding.'
          : `There are ${n} days until the wedding.`,
    },
  };

  const root = document.querySelector<HTMLElement>('[data-countdown]');
  const list = root?.querySelector<HTMLElement>('[data-countdown-list]');
  const today = root?.querySelector<HTMLElement>('[data-today]');
  const srStatus = root?.querySelector<HTMLElement>('[data-countdown-sr]');
  const target = root?.dataset.target
    ? new Date(root.dataset.target).getTime()
    : NaN;

  if (root && list && !Number.isNaN(target)) {
    const SECOND = 1000;
    const MINUTE = 60 * SECOND;
    const HOUR = 60 * MINUTE;
    const DAY = 24 * HOUR;

    let lastAnnouncedDays = -1;

    const render = () => {
      const diff = target - Date.now();
      const lang = currentLang();

      if (diff <= 0) {
        list.hidden = true;
        today?.classList.remove('hidden');
        if (srStatus) srStatus.textContent = SR_TEXT[lang].today;
        return true;
      }

      const values: Record<string, number> = {
        days: Math.floor(diff / DAY),
        hours: Math.floor((diff % DAY) / HOUR),
        minutes: Math.floor((diff % HOUR) / MINUTE),
        seconds: Math.floor((diff % MINUTE) / SECOND),
      };

      list.querySelectorAll<HTMLElement>('[data-unit]').forEach((item) => {
        const key = item.dataset.unit ?? '';
        const value = values[key] ?? 0;
        const valueEl = item.querySelector<HTMLElement>('[data-value]');
        const labelEl = item.querySelector<HTMLElement>('[data-label]');
        if (valueEl) valueEl.textContent = String(value);
        if (labelEl) {
          const suffix = lang === 'en' ? 'En' : '';
          labelEl.textContent =
            value === 1
              ? (item.dataset[`singular${suffix}`] ?? '')
              : (item.dataset[`plural${suffix}`] ?? '');
        }
      });

      // Oplæs kun én gang i døgnet, så skærmlæsere ikke afbrydes hvert sekund.
      if (srStatus && values.days !== lastAnnouncedDays) {
        lastAnnouncedDays = values.days;
        srStatus.textContent = SR_TEXT[lang].days(values.days);
      }

      return false;
    };

    document.addEventListener(LANG_EVENT, () => {
      lastAnnouncedDays = -1;
      render();
    });

    if (!render()) {
      const timer = window.setInterval(() => {
        if (render()) window.clearInterval(timer);
      }, 1000);
    }
  }
</script>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, tAttr, type Text } from '../i18n';

/**
 * Alle billeder i src/assets/gallery/ vises automatisk.
 * Byt placeholderne ud med rigtige fotos — filnavnene bestemmer rækkefølgen.
 */
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);

const altTexts: Record<string, Text> = {
  '01-forlovelse.jpg': {
    da: 'Ali og Berfin holder i hånd efter forlovelsen',
    en: 'Ali and Berfin holding hands after the engagement',
  },
  '02-ringene.jpg': {
    da: 'Nærbillede af forlovelsesringene',
    en: 'Close-up of the engagement rings',
  },
  '03-os-to.jpg': { da: 'Ali og Berfin sammen', en: 'Ali and Berfin together' },
  '04-detaljer.jpg': {
    da: 'Detaljer fra dagen',
    en: 'Details from the day',
  },
  '05-familien.jpg': {
    da: 'Ali og Berfin med familien',
    en: 'Ali and Berfin with the family',
  },
  '06-stedet.jpg': {
    da: 'Stemningsbillede fra festlokalet',
    en: 'Atmosphere shot from the venue',
  },
};

const fallbackAlt = {
  da: 'Billede af Ali og Berfin',
  en: 'Photo of Ali and Berfin',
};
const eyebrow = { da: 'Øjeblikke', en: 'Moments' };
const heading = { da: 'Galleri', en: 'Gallery' };
const intro = {
  da: 'Et lille udpluk af os. Flere billeder kommer til efter den store dag.',
  en: 'A small selection of us. More photos will follow after the big day.',
};
const enlarge = {
  da: 'Vis billedet i stor størrelse',
  en: 'Show the photo in full size',
};
const closeLabel = { da: 'Luk billede', en: 'Close photo' };
const prevLabel = { da: 'Forrige billede', en: 'Previous photo' };
const nextLabel = { da: 'Næste billede', en: 'Next photo' };

const photos = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b, 'da'))
  .map(([path, mod]) => {
    const file = path.split('/').pop() ?? '';
    return {
      src: mod.default,
      alt: altTexts[file] ?? fallbackAlt,
    };
  });
---

<section id="galleri" class="section">
  <div class="shell">
    <header class="reveal max-w-xl">
      <p class="eyebrow" {...t(eyebrow)}>
        {eyebrow.da}
      </p>
      <h2 class="section-title" {...t(heading)}>
        {heading.da}
      </h2>
      <hr class="rule" />
      <p class="mt-5 text-ink-soft" {...t(intro)}>
        {intro.da}
      </p>
    </header>

    <ul class="mt-12 grid grid-cols-2 gap-3 md:mt-16 md:grid-cols-3 md:gap-5">
      {photos.map((photo, index) => (
        <li class="reveal">
          <button
            type="button"
            class="group block w-full overflow-hidden rounded-xl bg-sand"
            data-lightbox-open
            data-index={index}
          >
            <Image
              src={photo.src}
              alt={photo.alt.da}
              {...tAttr('alt', photo.alt)}
              widths={[320, 640, 960]}
              sizes="(min-width: 768px) 30vw, 46vw"
              loading={index < 2 ? 'eager' : 'lazy'}
              class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <span class="sr-only" {...t(enlarge)}>
              {enlarge.da}
            </span>
          </button>
        </li>
      ))}
    </ul>
  </div>
</section>

<dialog
  data-lightbox
  class="max-h-dvh max-w-[100vw] bg-transparent backdrop:bg-ink/90"
>
  <div class="relative flex h-dvh w-screen items-center justify-center p-4">
    <button
      type="button"
      data-lightbox-close
      class="absolute right-4 top-4 z-10 inline-flex h-12 w-12 items-center justify-center rounded-full bg-canvas text-ink"
    >
      <span class="sr-only" {...t(closeLabel)}>
        {closeLabel.da}
      </span>
      <svg
        width="18"
        height="18"
        viewBox="0 0 18 18"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M1 1l16 16M17 1L1 17"
          stroke="currentColor"
          stroke-width="1.5"
        ></path>
      </svg>
    </button>

    <button
      type="button"
      data-lightbox-prev
      class="absolute left-3 z-10 inline-flex h-12 w-12 items-center justify-center rounded-full bg-canvas/90 text-ink"
    >
      <span class="sr-only" {...t(prevLabel)}>
        {prevLabel.da}
      </span>
      <svg
        width="12"
        height="20"
        viewBox="0 0 12 20"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M11 1L2 10l9 9"
          stroke="currentColor"
          stroke-width="1.5"
        ></path>
      </svg>
    </button>

    <button
      type="button"
      data-lightbox-next
      class="absolute right-3 z-10 inline-flex h-12 w-12 items-center justify-center rounded-full bg-canvas/90 text-ink"
    >
      <span class="sr-only" {...t(nextLabel)}>
        {nextLabel.da}
      </span>
      <svg
        width="12"
        height="20"
        viewBox="0 0 12 20"
        fill="none"
        aria-hidden="true"
      >
        <path d="M1 1l9 9-9 9" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
    </button>

    <img
      data-lightbox-image
      alt=""
      class="max-h-[88dvh] max-w-full object-contain"
    />
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const image = document.querySelector<HTMLImageElement>(
    '[data-lightbox-image]',
  );
  const triggers = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]'),
  );

  if (dialog && image && triggers.length) {
    let current = 0;

    const sourceFor = (index: number) => {
      const img = triggers[index]?.querySelector('img');
      return {
        // currentSrc giver den opløsning browseren allerede har hentet.
        src: img?.currentSrc || img?.src || '',
        alt: img?.alt ?? '',
      };
    };

    const show = (index: number) => {
      current = (index + triggers.length) % triggers.length;
      const { src, alt } = sourceFor(current);
      image.src = src;
      image.alt = alt;
    };

    const open = (index: number) => {
      show(index);
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    };

    triggers.forEach((trigger, index) =>
      trigger.addEventListener('click', () => open(index)),
    );

    dialog
      .querySelector('[data-lightbox-close]')
      ?.addEventListener('click', () => dialog.close());
    dialog
      .querySelector('[data-lightbox-prev]')
      ?.addEventListener('click', () => show(current - 1));
    dialog
      .querySelector('[data-lightbox-next]')
      ?.addEventListener('click', () => show(current + 1));

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
      triggers[current]?.focus();
    });

    // <dialog> lukker selv på Escape, men vi gør det eksplicit, så pile- og
    // Escape-tasterne håndteres samme sted og virker uanset hvor fokus er.
    document.addEventListener('keydown', (event) => {
      if (!dialog.open) return;
      if (event.key === 'Escape') dialog.close();
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });
  }
</script>

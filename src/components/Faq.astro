---
import { faq } from '../content/wedding';
---

<section id="faq" class="section bg-surface">
  <div class="shell">
    <header class="reveal max-w-xl">
      <p class="eyebrow">Godt at vide</p>
      <h2 class="section-title">Ofte stillede spørgsmål</h2>
      <hr class="rule" />
    </header>

    <div class="mt-12 max-w-2xl md:mt-16">
      {faq.map((item) => (
        <details
          class="reveal group border-b border-sand [&_svg]:open:rotate-45"
          name="faq"
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg marker:hidden [&::-webkit-details-marker]:hidden">
            <span class="font-display text-xl sm:text-2xl">
              {item.question}
            </span>
            <svg
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
              class="shrink-0 text-accent transition-transform duration-200"
            >
              <path
                d="M8 1v14M1 8h14"
                stroke="currentColor"
                stroke-width="1.25"
              />
            </svg>
          </summary>
          <p class="pb-6 pr-8 text-ink-soft">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

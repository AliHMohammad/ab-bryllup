---
import { venue, maps, weddingDate } from '../content/wedding';
import { compose, t, tAttr } from '../i18n';

const eyebrow = { da: 'Sådan finder I os', en: 'How to find us' };
const heading = { da: 'Lokation', en: 'Location' };
const when = compose((lang) =>
  lang === 'da'
    ? `${weddingDate.weekday.da} den ${weddingDate.dateLong.da} - vi begynder klokken ${weddingDate.time}.`
    : `${weddingDate.weekday.en} ${weddingDate.dateLong.en} - we begin at ${weddingDate.time}.`,
);
const mapTitle = compose(
  (lang) =>
    `${lang === 'da' ? 'Kort der viser' : 'Map showing'} ${venue.name}, ${venue.street}, ${venue.postalCode} ${venue.city}`,
);
const activateMap = {
  da: 'Tryk for at bruge kortet',
  en: 'Tap to use the map',
};
const mapData = { da: 'Kortdata fra', en: 'Map data from' };
---

<section id="sted" class="section bg-surface">
  <div class="shell">
    <div class="grid gap-10 md:grid-cols-2 md:items-center md:gap-14">
      <div class="reveal">
        <header class="mb-10">
          <p class="eyebrow" {...t(eyebrow)}>
            {eyebrow.da}
          </p>
          <h2 class="section-title" {...t(heading)}>
            {heading.da}
          </h2>
          <hr class="rule" />
        </header>

        <h3 class="text-2xl">{venue.name}</h3>
        <address class="mt-3 text-lead not-italic text-ink-soft">
          {venue.street}
          <br />
          {`${venue.postalCode} ${venue.city}`}
        </address>

        <p class="mt-4 text-ink-soft" {...t(when)}>
          {when.da}
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a
            class="btn btn-primary"
            href={maps.google}
            target="_blank"
            rel="noopener noreferrer"
          >
            Google Maps
          </a>
          <a
            class="btn btn-outline"
            href={maps.apple}
            target="_blank"
            rel="noopener noreferrer"
          >
            Apple Maps
          </a>
        </div>
      </div>

      <div class="reveal relative">
        <div
          class="relative overflow-hidden rounded-2xl border border-sand-deep/60 bg-sand"
          data-map
        >
          <iframe
            src={maps.osmEmbed}
            {...tAttr('title', mapTitle)}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="block h-88 w-full border-0 md:h-112"
          ></iframe>

          {/*
            Uden dette lag "fanger" kortet fingeren, når man scroller forbi på
            mobilen. Laget forsvinder ved tryk, så kortet stadig kan bruges.
          */}
          <button
            type="button"
            data-map-activate
            class="absolute inset-0 flex items-end justify-center bg-ink/5 pb-6 transition-colors hover:bg-ink/10"
          >
            <span
              class="rounded-full bg-canvas px-5 py-2.5 text-sm font-medium text-ink shadow-sm"
              {...t(activateMap)}
            >
              {activateMap.da}
            </span>
          </button>
        </div>
        {/* På desktop tæller linjen ikke med i højden, så teksten centreres på selve kortet. */}
        <p class="mt-3 text-xs text-ink-faint md:absolute md:top-full md:left-0">
          <span {...t(mapData)}>{mapData.da}</span>{' '}
          <a
            class="underline underline-offset-2 hover:text-accent"
            href={maps.osmLink}
            target="_blank"
            rel="noopener noreferrer"
          >
            OpenStreetMap
          </a>
          .
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { currentLang } from '../i18n';

  const wrapper = document.querySelector<HTMLElement>('[data-map]');
  const overlay = wrapper?.querySelector<HTMLButtonElement>(
    '[data-map-activate]',
  );

  if (wrapper && overlay) {
    overlay.addEventListener('click', () => overlay.remove());

    // Sæt laget tilbage når kortet ruller ud af syne, så det ikke stjæler scroll senere.
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting && !overlay.isConnected) {
            // Sproget kan være skiftet, mens laget var fjernet fra siden.
            const lang = currentLang();
            overlay
              .querySelectorAll<HTMLElement>('[data-i18n]')
              .forEach((el) => {
                el.textContent = el.getAttribute(`data-${lang}`) ?? '';
              });
            wrapper.append(overlay);
          }
        });
      },
      { threshold: 0 },
    );
    observer.observe(wrapper);
  }
</script>
